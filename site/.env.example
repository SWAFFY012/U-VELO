# Скопируйте в .env.local и заполните. Настоящие значения в репозиторий не кладём.

# Папка, куда сохраняются заявки (файл leads.jsonl). По умолчанию ./data
LEADS_DIR=

# Уведомления о заявках в Telegram (необязательно).
# Токен бота от @BotFather и ID чата, куда бот будет писать.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
